    "Year": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Année"
          }
        }
      }
    },
    "You can use every station open to all drivers on this network.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez utiliser toutes les bornes ouvertes à tous les conducteurs de ce réseau."
          }
        }
      }
    },
    "You have no active badge. Ask your charging operator to assign one to your account, or scan the QR code on the station to pay by card.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’avez aucun badge actif. Demandez-en un à votre exploitant, ou scannez le QR code de la borne pour payer par carte."
          }
        }
      }
    },
    "You pay a credit in advance. Whatever you do not use is refunded automatically.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous payez un crédit à l’avance. Ce que vous n’utilisez pas est remboursé automatiquement."
          }
        }
      }
    },
    "Your card is active.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre carte est active."
          }
        }
      }
    },
    "Your card is entered on Stripe's secure page and is never shared with this app.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre carte est saisie sur la page sécurisée de Stripe et n’est jamais communiquée à cette application."
          }
        }
      }
    },
    "Your card is ready. Activate it when you receive it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre carte est prête. Activez-la dès réception."
          }
        }
      }
    },
    "Your charging sessions will appear here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos sessions de recharge apparaîtront ici."
          }
        }
      }
    },
    "Your invoices will appear here.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos factures apparaîtront ici."
          }
        }
      }
    },
    "Your profile, vehicles, photos and device registrations are removed and your badges are disabled. Sessions and invoices kept for legal reasons no longer identify you.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre profil, vos véhicules, vos photos et vos appareils sont supprimés et vos badges sont désactivés. Les sessions et factures conservées pour raison légale ne vous identifient plus."
          }
        }
      }
    },
