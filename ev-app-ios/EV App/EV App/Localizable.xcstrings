          }
        }
      }
    },
    "Waiting for the station to confirm…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando la confirmación de la estación…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de la confirmation de la borne…"
          }
        }
      }
    },
    "What happened?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué ha pasado?"
          }
        },
        "fr": {
          "stringUnit": {
