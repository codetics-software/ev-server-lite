    "Charging stops when the credit runs out. The balance is refunded automatically, and in full if charging does not start within five minutes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carga se detiene cuando se agota el crédito. El saldo se reembolsa automáticamente, y en su totalidad si la carga no comienza en cinco minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recharge s’arrête quand le crédit est épuisé. Le solde est remboursé automatiquement, et en totalité si la recharge ne démarre pas sous cinq minutes."
          }
        }
      }
