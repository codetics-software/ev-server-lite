          }
        }
      }
    },
    "Year": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Año"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Année"
          }
        }
      }
    },
    "You can use every station open to all drivers on this network.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede usar todas las estaciones abiertas a todos los conductores de esta red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez utiliser toutes les bornes ouvertes à tous les conducteurs de ce réseau."
          }
        }
      }
    },
    "You have no active badge. Ask your charging operator to assign one to your account, or scan the QR code on the station to pay by card.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tiene ninguna tarjeta activa. Pida a su operador de carga que asigne una a su cuenta o escanee el código QR de la estación para pagar con tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’avez aucun badge actif. Demandez-en un à votre exploitant, ou scannez le QR code de la borne pour payer par carte."
          }
        }
      }
    },
    "You pay a credit in advance. Whatever you do not use is refunded automatically.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usted paga un crédito por adelantado. Lo que no utilice se le reembolsa automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous payez un crédit à l’avance. Ce que vous n’utilisez pas est remboursé automatiquement."
          }
        }
      }
    },
    "Your card is active.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su tarjeta está activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre carte est active."
          }
        }
      }
    },
    "Your card is entered on Stripe's secure page and is never shared with this app.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su tarjeta se introduce en la página segura de Stripe y nunca se comparte con esta aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre carte est saisie sur la page sécurisée de Stripe et n’est jamais communiquée à cette application."
          }
        }
      }
    },
    "Your card is ready. Activate it when you receive it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su tarjeta está lista. Actívela cuando la reciba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre carte est prête. Activez-la dès réception."
          }
        }
      }
    },
    "Your charging sessions will appear here.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus sesiones de carga aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos sessions de recharge apparaîtront ici."
          }
        }
      }
    },
    "Your invoices will appear here.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus facturas aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos factures apparaîtront ici."
          }
        }
      }
    },
    "Your profile, vehicles, photos and device registrations are removed and your badges are disabled. Sessions and invoices kept for legal reasons no longer identify you.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminan su perfil, sus vehículos, sus fotos y los registros de sus dispositivos, y se desactivan sus tarjetas. Las sesiones y facturas conservadas por motivos legales dejan de identificarle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre profil, vos véhicules, vos photos et vos appareils sont supprimés et vos badges sont désactivés. Les sessions et factures conservées pour raison légale ne vous identifient plus."
          }
        }
      }
    },
    "Your session": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su sesión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session"
          }
        }
      }
    },
    "Your session appears here once it starts.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su sesión aparecerá aquí en cuanto comience."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session apparaîtra ici dès son démarrage."
          }
        }
      }
    },
    "Your session has expired. Sign in again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su sesión ha caducado. Vuelva a iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session a expiré. Reconnectez-vous."
          }
        }
      }
    },
