    "Use as my default vehicle": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar como mi vehículo predeterminado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser comme véhicule par défaut"
          }
        }
      }
    },
    "Use between 16 and 128 characters. A sentence works well.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use entre 16 y 128 caracteres. Una frase funciona bien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez entre 16 et 128 caractères. Une phrase convient très bien."
          }
        }
      }
    },
    "Use the number printed on the card or given by your operator. Only a card you ordered on this account can be activated.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use el número impreso en la tarjeta o facilitado por su operador. Solo se puede activar una tarjeta pedida con esta cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le numéro imprimé sur la carte ou donné par votre exploitant. Seule une carte commandée sur ce compte peut être activée."
          }
        }
      }
    },
    "VIN": {
      "localizations": {
