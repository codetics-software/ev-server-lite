# Configuration du serveur Java : valeurs à définir chez votre hébergeur.
DATABASE_URL=jdbc:postgresql://localhost:5432/ev_supervision
DATABASE_USER=ev_supervision
DATABASE_PASSWORD=remplacer-par-un-secret
APP_PUBLIC_URL=https://supervision.exemple.fr
COOKIE_SECURE=true
PORT=8080

# Création du premier administrateur, uniquement sur une base sans utilisateur.
BOOTSTRAP_TENANT=codetics
BOOTSTRAP_EMAIL=administrateur@exemple.fr
BOOTSTRAP_PASSWORD=remplacer-par-une-longue-phrase-de-passe

# Courriels et création d’espaces clients.
MAIL_ENABLED=false
MAIL_FROM=supervision@exemple.fr
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
WORKSPACE_SIGNUP_ENABLED=false
SIGNUP_ENABLED=false
PUBLIC_TENANT=

# Paiements Stripe des comptes connectés. Utiliser les clés de test pendant les essais.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Clé publiable, nécessaire à l’enregistrement des moyens de paiement des conducteurs.
STRIPE_PUBLISHABLE_KEY=
# Générer une clé aléatoire avec : openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Plages (CIDR) des mandataires, dont le tableau de bord, autorisés à transmettre X-Forwarded-For.
# Sert aux limites de connexion, d’inscription et de paiement public par adresse du visiteur.
APP_TRUSTED_PROXIES=

# Administrateurs de la plateforme (adresses de l’espace BOOTSTRAP_TENANT, séparées par des virgules).
PLATFORM_ADMIN_EMAILS=

# Itinérance OCPI : adresse publique du serveur Java et identifiants de l’opérateur.
OCPI_PUBLIC_URL=https://ocpi.exemple.fr
OCPI_COUNTRY_CODE=FR
OCPI_PARTY_ID=COD

# Synchronisation du catalogue de véhicules EV Database (facultative).
EV_DATABASE_API_KEY=

# Bornes OCPP 1.6 : profils de sécurité et mandataire inverse.
# Adresse publique des connexions des bornes, affichée dans la fiche de mise en service (ex. wss://ocpp.exemple.fr/ocpp).
OCPP_PUBLIC_URL=
# Plages (CIDR, séparées par des virgules) des mandataires dont X-Forwarded-For, X-Forwarded-Proto
# et l’en-tête du certificat client sont acceptés. Vide : aucun mandataire de confiance.
OCPP_TRUSTED_PROXIES=
# En-tête du certificat client transmis par le mandataire (profil 3), par exemple X-Client-Cert.
# Le mandataire doit vérifier ce certificat et remplacer toute copie envoyée par le client.
OCPP_CLIENT_CERT_HEADER=
# Plages des seuls mandataires autorisés à transmettre cet en-tête. Vide : OCPP_TRUSTED_PROXIES.
OCPP_CLIENT_CERT_PROXIES=
# Autorités des certificats de bornes (PEM, ou chemin d’un fichier PEM).
OCPP_CLIENT_CA=
# Autorité qui signe les demandes de certificat des bornes (PEM ou chemin ; clé PKCS#8).
OCPP_SIGNING_CA_CERTIFICATE=
OCPP_SIGNING_CA_KEY=
OCPP_SIGNED_CERTIFICATE_DAYS=365
# Autorise les bornes existantes configurées en profil 0, sans authentification.
OCPP_ALLOW_UNAUTHENTICATED=false
# Intervalle de battement par défaut, en secondes (10 à 300).
OCPP_HEARTBEAT_SECONDS=60
