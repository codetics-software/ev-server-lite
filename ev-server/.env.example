# Configuration du serveur Java : valeurs à définir chez votre hébergeur.
DATABASE_URL=jdbc:postgresql://localhost:5432/ev_supervision
DATABASE_USER=ev_supervision
DATABASE_PASSWORD=remplacer-par-un-secret
APP_PUBLIC_URL=https://supervision.exemple.fr
COOKIE_SECURE=true
PORT=8080

# Création du premier administrateur, uniquement sur une base sans utilisateur.
BOOTSTRAP_TENANT=codetics
BOOTSTRAP_EMAIL=administrateur@exemple.fr
BOOTSTRAP_PASSWORD=remplacer-par-une-longue-phrase-de-passe

# Courriels et création d’espaces clients.
MAIL_ENABLED=false
MAIL_FROM=supervision@exemple.fr
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
WORKSPACE_SIGNUP_ENABLED=false
SIGNUP_ENABLED=false
PUBLIC_TENANT=

# Paiements Stripe des comptes connectés. Utiliser les clés de test pendant les essais.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Générer une clé aléatoire avec : openssl rand -base64 32
APP_ENCRYPTION_KEY=
