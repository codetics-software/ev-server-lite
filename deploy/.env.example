# Copier en deploy/.env. Valeurs lues par docker compose, jamais transmises au navigateur.
# Adresse du tableau de bord, de l’API, des notifications Stripe, d’OCPI et des bornes en profils 1 et 2.
APP_HOST=supervision.exemple.fr
# Adresse distincte des bornes en profil 3, active si caddy/sites/ocpp-mtls.caddy existe.
OCPP_HOST=ocpp.exemple.fr
# Adresse de contact pour les certificats Let’s Encrypt.
ACME_EMAIL=exploitation@exemple.fr
# PostgreSQL local (profil local-db). Pour une base gérée : retirer local-db de COMPOSE_PROFILES
# et définir DATABASE_URL, par exemple jdbc:postgresql://10.0.0.5:5432/ev_supervision?sslmode=require.
COMPOSE_PROFILES=local-db
# DATABASE_URL=
DATABASE_USER=ev_supervision
# Générer avec : openssl rand -base64 32
DATABASE_PASSWORD=remplacer-par-un-secret
# Mémoire de la JVM : pourcentage de la mémoire du conteneur.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
