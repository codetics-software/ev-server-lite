# Copier en deploy/server.env. Variables du serveur Java ; docker-compose.yml fixe déjà
# DATABASE_*, PORT, APP_PUBLIC_URL, OCPI_PUBLIC_URL, COOKIE_SECURE, APP_TRUSTED_PROXIES,
# OCPP_TRUSTED_PROXIES, OCPP_CLIENT_CERT_PROXIES et OCPP_CLIENT_CERT_HEADER. La liste complète figure dans docs/deploiement/README.md.

BOOTSTRAP_TENANT=codetics
BOOTSTRAP_EMAIL=administrateur@exemple.fr
BOOTSTRAP_PASSWORD=remplacer-par-une-longue-phrase-de-passe

MAIL_ENABLED=false
MAIL_FROM=supervision@exemple.fr
SMTP_HOST=smtp.exemple.fr
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
WORKSPACE_SIGNUP_ENABLED=false
SIGNUP_ENABLED=false
PUBLIC_TENANT=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
APP_ENCRYPTION_KEY=

PLATFORM_ADMIN_EMAILS=

OCPI_COUNTRY_CODE=FR
OCPI_PARTY_ID=COD

EV_DATABASE_API_KEY=

# Profil 3 : autorités des certificats de bornes (PEM sur une ligne avec \n, ou chemin de fichier monté).
OCPP_CLIENT_CA=
# Signature des CSR envoyées par les bornes (SignCertificate). Clé PKCS#8.
OCPP_SIGNING_CA_CERTIFICATE=
OCPP_SIGNING_CA_KEY=
OCPP_SIGNED_CERTIFICATE_DAYS=365
OCPP_ALLOW_UNAUTHENTICATED=false
OCPP_HEARTBEAT_SECONDS=60
# Adresse publique des bornes, par exemple wss://ocpp.exemple.fr/ocpp.
OCPP_PUBLIC_URL=

# Journaux JSON pour un collecteur : décommenter (ecs, logstash ou gelf).
# LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs

# Application mobile : durée des sessions (jours, 90 au plus).
APP_SESSION_DAYS=30

# Notifications push Apple (APNs) : clé .p8 (PEM ou chemin de fichier), identifiants et identifiant de l’application.
APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=

# Notifications push Android (Firebase Cloud Messaging) : compte de service Firebase (JSON, Base64 ou chemin de fichier). FCM_PROJECT_ID remplace le projet du compte de service.
FCM_SERVICE_ACCOUNT=
FCM_PROJECT_ID=

# Apple Wallet : certificat Pass Type ID (.p12 en Base64 ou chemin), certificat WWDR (PEM, Base64 ou chemin).
WALLET_PASS_TYPE_ID=
WALLET_TEAM_ID=
WALLET_ORGANIZATION_NAME=
WALLET_CERTIFICATE=
WALLET_CERTIFICATE_PASSWORD=
WALLET_WWDR_CERTIFICATE=
# Clé publique ECDH P-256 du lecteur NFC (X.509 en Base64, attribuée avec l’autorisation NFC d’Apple). Vide : QR code seul.
WALLET_NFC_PUBLIC_KEY=

# Google Wallet : identifiant d’émetteur et compte de service autorisé dans la Pay & Wallet Console (JSON, Base64 ou chemin de fichier).
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT=
GOOGLE_WALLET_CLASS_SUFFIX=ev_charging_badge
GOOGLE_WALLET_ORGANIZATION_NAME=
# Identifiant d’émetteur Smart Tap des lecteurs NFC (attribué par Google). Vide : QR code seul.
GOOGLE_WALLET_SMART_TAP_REDEMPTION_ISSUER=
